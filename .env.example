PORT=3000
NODE_ENV=development

# App URL
BASE_URL=http://localhost:3000

# Postgres (used by docker-compose database service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=product_stock_manager

# Use host "db" when running app and database in Docker Compose
DATABASE_URL=postgresql://postgres:1234@db:5432/product_stock_manager