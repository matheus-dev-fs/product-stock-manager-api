{
    "name": "product-stock-manager-api",
    "version": "1.0.0",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from app-test; EXIT_CODE=$?; docker compose -f docker-compose.test.yml down -v; exit $EXIT_CODE",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "drizzle-orm": "^0.45.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "pino": "^9.0.0",
        "postgres": "^3.4.8",
        "sharp": "^0.34.5",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.10.6",
        "drizzle-kit": "^0.31.8",
        "jest": "^30.3.0",
        "pino-pretty": "^11.0.0",
        "ts-jest": "^29.4.9",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3"
    }
}